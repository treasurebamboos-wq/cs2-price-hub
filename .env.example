# CS2 Price Hub 配置文件
# 复制此文件为 .env 并修改配置

# 调试模式
DEBUG=true

# API服务配置
API_HOST=0.0.0.0
API_PORT=8000

# 爬取间隔（分钟）
SCRAPE_INTERVAL_MINUTES=5

# 请求延迟（秒）- 太快容易被封
REQUEST_DELAY=2.0

# Buff Cookie（可选，不填则不爬取Buff）
# 获取方式：登录buff.163.com -> F12 -> Network -> 复制Cookie
BUFF_COOKIE=

# Steam API Key（可选）
# 获取：https://steamcommunity.com/dev/apikey
STEAM_API_KEY=
